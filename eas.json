{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://parentpal-api-fc4j.onrender.com"
      }
    },
    "preview-testflight": {
      "distribution": "store",
      "env": {
        "API_URL": "https://parentpal-api-fc4j.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://parentpal-api-fc4j.onrender.com"
      }
    }
  }
}
